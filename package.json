{
  "name": "nozzle-js",
  "version": "0.10.0",
  "description": "Chainable stream processing for async iterators. Transform LLM responses, event streams, and more with a fluent API.",
  "keywords": [
    "stream",
    "async",
    "iterator",
    "pipeline",
    "transform",
    "llm",
    "streaming",
    "async-iterator",
    "functional",
    "chainable"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    "require": "./dist/index.js",
    "import": "./dist/index.mjs"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build-fast": "tsup src/index.ts --format cjs,esm",
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest run",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "docs": "node --import tsx scripts/generate-docs.ts",
    "demos": "tsx scripts/viz/demos/generate-readme-demos.ts",
    "prepublishOnly": "pnpm run build && pnpm run docs",
    "prerelease": "pnpm run build && pnpm run docs && pnpm run lint && pnpm run test",
    "release:patch": "pnpm run prerelease && npm version patch && npm publish && git push --follow-tags",
    "release:minor": "pnpm run prerelease && npm version minor && npm publish && git push --follow-tags",
    "release:major": "pnpm run prerelease && npm version major && npm publish && git push --follow-tags",
    "release:dry": "pnpm run prerelease && npm pack --dry-run",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@egoist/prettier-config": "1.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "prettier": "3.5.3",
    "puppeteer": "^24.2.1",
    "tsup": "8.5.0",
    "tsx": "^4.22.4",
    "typedoc": "^0.28.5",
    "typescript": "5.8.3",
    "vitest": "3.2.1"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
